# Шаблон переменных keflab.ru. Это пример, не файл с настройками: реальные значения
# не коммитить. Где что хранится:
#   - сборка: GitHub → Settings → Secrets and variables → Variables (репозитория);
#   - рантайм: /etc/keflab/keflab.env и /etc/keflab/keflab-staging.env на VPS (root:keflab, 0640);
#   - деплой: GitHub → Environments → Secrets (не в файлах).
# Формат: только строки KEY=VALUE, без комментариев в той же строке (так читает systemd).

# === Сборка (npm run build). Значения попадают в предсобранные страницы.
# В рантайм не задавать: иной конфиг SSR не совпадёт с хэшами CSP (см. README).
# Номер счётчика Яндекс Метрики. Пусто — Метрика не подключается. Для staging код сборки оставляет пусто.
NUXT_PUBLIC_METRIKA_ID=
# Метатег подтверждения Яндекс Вебмастера (содержимое content).
NUXT_PUBLIC_YANDEX_VERIFICATION=
# Метатег подтверждения Google Search Console.
NUXT_PUBLIC_GOOGLE_VERIFICATION=

# === Офферы (сборка и рантайм). Включать только после регистрации сайта как СМИ (шаг 7).
# Рантайм читает флаг процессом Node при старте: после изменения — systemctl restart.
# Только строка true включает офферы; всё остальное — выключено.
OFFERS_ENABLED=false

# === Рантайм (/etc/keflab/keflab.env, production)
NODE_ENV=production
# Слушать только локальный адрес: снаружи Node недоступен, всё через Nginx.
NITRO_HOST=127.0.0.1
NITRO_PORT=3000
PORT=3000

# === Рантайм (/etc/keflab/keflab-staging.env, staging): те же ключи, порт другой.
# NITRO_PORT=3001
# PORT=3001

# === Деплой (только GitHub Secrets и Variables окружения, не файл на машине разработчика)
# Адрес VPS. Проверка ключа хоста обязательна: DEPLOY_KNOWN_HOSTS — строка(и) из ssh-keyscan
# после сверки отпечатка с тем, что показал хостер.
DEPLOY_HOST=
DEPLOY_USER=deploy
# Приватный ключ пользователя deploy, многострочный, целиком.
DEPLOY_SSH_KEY=
DEPLOY_KNOWN_HOSTS=

# === Откат с локальной машины (deploy/scripts/remote-rollback.sh)
KEFLAB_SSH_TARGET=deploy@
# Путь к приватному ключу на вашей машине (необязательно, если ключ в ssh-agent).
KEFLAB_SSH_KEY=
