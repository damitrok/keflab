# /etc/systemd/system/keflab-staging.service — staging (staging.keflab.ru), порт 3001.
# Установка и проверка: README, раздел «Восстановление на новом VPS».
#
# Node — версия из .nvmrc (24). Путь к бинарнику ниже: при установке в другое место
# поправить ExecStart и выполнить: sudo systemctl daemon-reload && sudo systemctl restart keflab-staging
# Переменные: /etc/keflab/keflab-staging.env (шаблон — .env.example, раздел «Рантайм»).

[Unit]
Description=keflab staging (Nitro)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=keflab
Group=keflab
UMask=0027

WorkingDirectory=/srv/keflab-staging/current
EnvironmentFile=/etc/keflab/keflab-staging.env
ExecStart=/opt/node-24/bin/node .output/server/index.mjs

Restart=always
RestartSec=2

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/srv/keflab-staging/shared
ProtectHome=yes
ProtectProc=invisible
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
SystemCallArchitectures=native
SystemCallFilter=@system-service

StandardOutput=journal
StandardError=journal
SyslogIdentifier=keflab-staging

[Install]
WantedBy=multi-user.target
